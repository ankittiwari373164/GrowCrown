# Server-only configuration. Copy to .env locally; use encrypted secrets in production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
# Use a unique password of at least 12 characters. No default password exists.
ADMIN_PASSWORD=
# Generate 32+ random characters; changing it invalidates all admin sessions.
ADMIN_SESSION_SECRET=
